{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cabecera de un bloque de texto del PCCF (Markdown con cabecera YAML)",
  "type": "object",
  "required": ["tipo", "apartado", "origen", "estado", "aportado_por", "fecha"],
  "properties": {
    "tipo": {"enum": ["centro", "ciclo", "anual", "normativo"]},
    "apartado": {"type": "integer", "minimum": 1, "maximum": 18},
    "origen": {
      "type": "string",
      "description": "catálogo, equipo, propuesta (texto sugerido que el equipo revisa) o «heredado del curso AAAA-AAAA»",
      "pattern": "^(catálogo|equipo|propuesta|heredado del curso \\d{4}-\\d{4})$"
    },
    "estado": {"enum": ["borrador", "confirmado"]},
    "aportado_por": {"type": "string", "minLength": 1},
    "fecha": {"type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "orden": {"type": "integer", "description": "Orden dentro del apartado; sin él, el del nombre del archivo"},
    "citas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["norma"],
        "properties": {"norma": {"type": "string"}, "articulo": {"type": "string"}},
        "additionalProperties": false
      }
    },
    "tags": {"type": "array", "description": "Campos de las notas de Documentos: la app no los usa"},
    "fecha_actualizacion": {"type": "string"},
    "resumen": {"type": "string"}
  },
  "additionalProperties": false
}
