{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Departamentos del centro y sus ciclos (centro/departamentos.yaml, ADR-012)",
  "type": "object",
  "required": ["fecha", "departamentos"],
  "properties": {
    "fecha": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "departamentos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "nombre", "jefatura", "orden", "ciclos"],
        "properties": {
          "id": {"type": "string"},
          "nombre": {"type": "string"},
          "jefatura": {"type": "string"},
          "orden": {"type": "integer", "minimum": 1},
          "ciclos": {"type": "array", "items": {"type": "string"}, "minItems": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
