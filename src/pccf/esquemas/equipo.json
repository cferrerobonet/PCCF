{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Equipo docente de un ciclo en un curso (cursos/<curso>/<SIGLA>/equipo.yaml)",
  "type": "object",
  "required": [
    "ciclo",
    "curso",
    "fecha",
    "estado",
    "docentes",
    "modulos"
  ],
  "properties": {
    "ciclo": {
      "type": "string"
    },
    "curso": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{4}$"
    },
    "fecha": {
      "type": [
        "string"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "estado": {
      "enum": [
        "borrador",
        "confirmado"
      ]
    },
    "origen": {
      "type": "string",
      "description": "Solo si se ha heredado del curso anterior («Nuevo curso»): hasta confirmarlo, el estado es borrador",
      "pattern": "^heredado del curso \\d{4}-\\d{4}$"
    },
    "docentes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "codigo",
          "nombre"
        ],
        "properties": {
          "codigo": {
            "type": "string"
          },
          "nombre": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "tutorias": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "curso",
          "grupo",
          "docente"
        ],
        "properties": {
          "curso": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2
          },
          "grupo": {
            "type": "string"
          },
          "docente": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "modulos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "modulo",
          "docentes"
        ],
        "properties": {
          "modulo": {
            "type": "string",
            "description": "Clave del módulo en el catálogo: el código del horario («0524», «0526p») o, en un optativo, su identificador («OPT-EE-IA»)"
          },
          "siglas": {
            "type": "string"
          },
          "docentes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
